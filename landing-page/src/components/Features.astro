---
// Features section. Each card shows one still frame of the app, rendered at build time: no animation, no script.

// Seeded so every build draws the same graphs.
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(7);
const between = (a: number, b: number) => a + rand() * (b - a);
const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
const walk = (prev: number, lo: number, hi: number, step: number) => clamp(prev + between(-step, step), lo, hi);

// Block-character bar graph, `h` rows tall, newest sample on the right (same drawing as the app).
const BL = " ▁▂▃▄▅▆▇█";
function blocks(vals: number[], h: number, max: number, lo = 0) {
  const rows: string[] = [];
  for (let r = 0; r < h; r++) {
    let s = "";
    for (const x of vals) {
      let n = clamp(Math.round(((Math.max(0, x - lo) / (max - lo)) * h * 8) - (h - 1 - r) * 8), 0, 8);
      if (r === h - 1 && x > 0 && n === 0) n = 1;
      s += BL[n];
    }
    rows.push(s);
  }
  return rows.join("\n");
}
function series(n: number, next: (p: number | undefined) => number) {
  const v: number[] = [];
  for (let i = 0; i < n; i++) v.push(next(v.at(-1)));
  return v;
}
const COLS = 90; // wider than any card; the graph is right-aligned and clipped on the left
const METRICS = [
  { n: "CPU", cls: "cpu", max: 60, lo: 0, f: (x: number) => x.toFixed(1) + "%", v: series(COLS, (p) => walk(p ?? 18, 2, 55, 7)) },
  { n: "Memory", cls: "mem", max: 250, lo: 140, f: (x: number) => x.toFixed(0) + " MiB", v: series(COLS, (p) => walk(p ?? 186, 170, 240, 5)) },
  { n: "Tasks", cls: "tasks", max: 22, lo: 4, f: (x: number) => String(Math.round(x)), v: series(COLS, (p) => clamp(Math.round(walk(p ?? 9, 7, 20, 2)), 7, 20)) },
  { n: "Disk I/O", cls: "disk", max: 900, lo: 0, f: (x: number) => "W " + x.toFixed(1) + " KiB/s", v: series(COLS, () => (rand() < 0.3 ? between(300, 880) : between(10, 160))) },
];

const FILTER_Q = "pos";
const FILTER = [
  ["containerd.service", 1], ["cron.service", 1], ["docker.service", 1], ["nginx.service", 1],
  ["postgresql.service", 1], ["postgres-exporter.service", 0], ["redis-server.service", 1], ["ssh.service", 1],
].filter(([n]) => (n as string).includes(FILTER_Q)) as [string, number][];

const LOGS: [string, string, string][] = [
  ["09:42:01", "info", "GET /v1/orders 200 12ms"],
  ["09:42:02", "info", "GET /v1/users/42 200 4ms"],
  ["09:42:04", "warn", "slow query 412ms orders_by_user"],
  ["09:42:05", "info", "POST /v1/checkout 201 38ms"],
  ["09:42:07", "ev", "── api is not running; logs resume when it starts ──"],
  ["09:42:11", "ok", "── api started ──"],
  ["09:42:11", "info", "listening on :8080"],
];

const ENV: [string, string, boolean][] = [
  ["NODE_ENV", "production", false], ["PORT", "8080", false], ["POSTGRES_PASSWORD", "", true],
  ["API_TOKEN", "", true], ["AWS_SECRET_ACCESS_KEY", "", true], ["LOG_LEVEL", "info", false],
];

const LIMITS: [string, string][] = [["CPUs", "2"], ["Memory", "2g"], ["Memory+swap", "2g"], ["PIDs limit", "200"], ["Restart", "unless-stopped"]];

const PLATFORMS = [
  { os: "Docker or Podman · Linux, macOS", w: "docker", c: "|podman", l: ["ps and stats every 2s", "Compose projects: up, down, pull, build", "Podman pods without their infra containers", "Inspect env, ports, mounts, networks", "Logs from logs -f and compose logs -f", "Limits and restart policy with update"] },
  { os: "Linux · systemd", w: "system", c: "ctl", l: ["System and --user units", "Details from systemctl show", "Logs from journalctl -f", "Edit unit files with Alt+e", "daemon-reload with Alt+Shift+r"] },
  { os: "macOS · launchd", w: "launch", c: "ctl", l: ["Jobs from launchctl list", "Start and stop with load / unload", "Details from launchctl list <label>", "Install with Homebrew"] },
];

// Rows of the compose card: "p" projects, "c" their containers, "s" standalone containers, "-" a group label (m: its count).
type Row = { k: "p" | "c" | "s" | "-"; n: string; m?: string; s?: string; on?: boolean; d?: string; last?: boolean; warn?: boolean };
const PROJECT: Row[] = [
  { k: "-", n: "COMPOSE", m: "2 projects" },
  { k: "p", n: "shop", m: "compose · 4 services", s: "● 5/5 up", on: true, d: "⚠ 1 changed" },
  { k: "c", n: "api", m: "node:22-slim", s: "● running", on: true },
  { k: "c", n: "postgres", m: "postgres:16", s: "● running", on: true },
  { k: "c", n: "web", m: "nginx:1.27-alpine", s: "● running", on: true, warn: true },
  { k: "c", n: "worker #1", m: "python:3.12-slim", s: "● running", on: true },
  { k: "c", n: "worker #2", m: "python:3.12-slim", s: "● running", on: true, last: true },
  { k: "p", n: "blog", m: "compose · saved", s: "○ down", d: "Alt+o to bring up" },
  { k: "-", n: "STANDALONE", m: "1 container" },
  { k: "s", n: "traefik", m: "traefik:v3.1", s: "● running", on: true },
];


---

<section class="sec" id="features">
  <div class="wrap">
    <div class="head">
      <h2 data-r>Features</h2>
      <p class="sub" data-r style="--d:1">What you get on top of <code>docker</code> or <code>podman</code>, compose, <code>systemctl</code> and <code>launchctl</code>.</p>
    </div>

    <div class="bento">
      <article class="card s2" data-r>
        <div class="vg" aria-hidden="true">
          <div class="win">
            <div class="win-h"><b>Containers</b> · grouped by compose project <span class="r8">every 2s</span></div>
            <ul class="cp">
              {PROJECT.map((r) => r.k === "-" ? <li class:list={["dv", { sa: r.n === "STANDALONE" }]}><i>──</i><b>{r.n}</b>{r.m}<u /></li> : (
                <li class:list={{ pj: r.k === "p" }}>
                  <span class="n">{r.k === "p" ? <i>{r.s === "○ down" ? "▹" : "▾"}</i> : r.k === "c" ? <i>{r.last ? "└" : "├"}</i> : null}{r.n}{r.warn && <em> ⚠</em>}</span>
                  <span class="m">{r.m}</span>
                  <span class:list={["s", { on: r.on }]}>{r.s}</span>
                  <span class:list={["d", { w: r.d?.startsWith("⚠") }]}>{r.d}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div>
          <h3>Docker Compose projects</h3>
          <p>Containers are grouped under their project and shown by service, with summed CPU and memory. A project row
            starts, stops or restarts the whole project; <code>Alt+u</code>, <code>Alt+p</code> and <code>Alt+d</code> run
            <code>up -d</code>, <code>pull</code> and <code>down</code>. Projects stay listed after <code>down</code>.</p>
        </div>
      </article>

      <article class="card" data-r style="--d:1">
        <div class="vg" aria-hidden="true">
          <div class="win">
            <div class="win-h"><b>shop</b> · project page</div>
            <div class="cmd">
              <div class="row"><span class="lbl">State</span><span class="dr-on">● 5/5 up</span></div>
              <div class="row"><span class="lbl">Files</span><span>/srv/shop/compose.yaml</span></div>
              <div class="row"><span class="lbl">Config</span><span class="dr-w">⚠ changed: web</span></div>
            </div>
            <div class="dr-run">
              <div><kbd>Alt</kbd><kbd>u</kbd><span>docker compose up -d</span></div>
              <div class="dr-ok">✓ containers match the compose files</div>
            </div>
          </div>
        </div>
        <div>
          <h3>Spot changed compose files</h3>
          <p>Each service's config hash is checked against <code>compose config</code>. Edited files show a warning;
            <code>Alt+u</code> recreates what changed.</p>
        </div>
      </article>

      <article class="card s2" data-r>
        <div class="vg" aria-hidden="true">
          <div class="win">
            <div class="win-h"><b>postgresql.service</b> · graphs <span class="r8">every 2s</span></div>
            <div class="graphs">
              {METRICS.map((m) => (
                <div class={`gm ${m.cls}`}>
                  <div class="gl"><span>{m.n}</span><b>{m.f(m.v.at(-1)!)}</b></div>
                  <div class="gw"><pre>{blocks(m.v, 3, m.max, m.lo)}</pre></div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div>
          <h3>Graphs on the detail page</h3>
          <p>CPU, memory, tasks and IO, sampled every 2 seconds, last 10 minutes kept. At 100+ columns they sit beside the
            summary. On narrower terminals <code>Alt+g</code> switches between the two.</p>
        </div>
      </article>

      <article class="card" data-r style="--d:1">
        <div class="vg" aria-hidden="true">
          <div class="win">
            <div class="fl-in">Filter: <span>{FILTER_Q}</span><span class="cur">█</span></div>
            <ul class="fl-list">
              {FILTER.map(([n, on]) => {
                // The app narrows the list; it does not highlight the match.
                return (
                  <li>
                    <span>{n}</span>
                    <span class:list={["s", { o: !on }]}>{on ? "● active" : "○ inactive"}</span>
                  </li>
                );
              })}
            </ul>
            <div class="fl-n">{FILTER.length}/8 services</div>
          </div>
        </div>
        <div>
          <h3>Type to filter</h3>
          <p>There is no search mode: typing narrows the list. <code>-f nginx</code> starts with a filter.</p>
        </div>
      </article>

      <article class="card" data-r>
        <div class="vg" aria-hidden="true">
          <div class="safe">
            <div class="svcrow"><span><i>▌</i>postgresql.service</span><span class="s">● active</span></div>
            <div class="cdlg">
              <div class="t">Confirm</div>
              <div class="q">Stop service postgresql.service?</div>
              <div class="bb"><span class="yes">y  Stop</span><span class="no">n  Cancel</span></div>
              <div class="f">y confirm · n / Esc cancel</div>
            </div>
            <div class="ks"><kbd class="bad">Enter</kbd><span class="tag bad">ignored</span><kbd class="good">y</kbd><span class="tag good">confirms</span></div>
          </div>
        </div>
        <div>
          <h3>Stop and restart ask first</h3>
          <p><code>Enter</code> only opens views. Stop and restart run after <code>y</code> or a click on the confirm button.</p>
        </div>
      </article>

      <article class="card s2" data-r style="--d:1">
        <div class="vg" aria-hidden="true">
          <div class="win">
            <div class="win-h"><b>worker.service</b> · summary</div>
            <div class="cmd">
              <div class="row"><span class="lbl">Type</span><span>simple</span></div>
              <div class="row"><span class="lbl">User</span><span>app</span></div>
              <div class="row"><span class="lbl">Command</span>
                <div class="lines">
                  <div><span class="bin">sh</span> <span class="op">-c</span></div>
                  <div>  <span class="val">cd /srv/app</span></div>
                  <div>  <span class="sepr">&amp;&amp;</span> <span class="val">exec</span> <span class="bin">python3</span> <span class="val">server.py</span></div>
                  <div>    <span class="op">--workers</span> <span class="val">4</span></div>
                  <div>    <span class="op">--bind</span> <span class="val">0.0.0.0:80</span></div>
                </div>
              </div>
              <div class="row"><span class="lbl">Wanted by</span><span>multi-user.target</span></div>
            </div>
            <div class="cmd-note"><span class="sw">●</span><span>split one option per line</span></div>
          </div>
        </div>
        <div>
          <h3>Long commands, one option per line</h3>
          <p><code>ExecStart</code> lines and Docker entrypoints are split one option per line. The script inside
            <code>sh -c</code> is indented one more level.</p>
        </div>
      </article>

      <article class="card" data-r>
        <div class="vg" aria-hidden="true">
          <div class="win">
            <div class="win-h"><b>api</b> · docker logs -f</div>
            <div class="lg">
              {LOGS.map(([ts, kind, msg]) => (
                <div><span class="ts">{ts}</span> {kind === "ev" || kind === "ok" ? <span class={kind}>{msg}</span> : <><span class="lvl">{kind}</span> {msg}</>}</div>
              ))}
            </div>
          </div>
        </div>
        <div>
          <h3>Logs follow restarts</h3>
          <p><code>journalctl -f</code> for services, <code>docker logs -f</code> for containers. If a container restarts
            or is recreated with the same name, the log continues where it stopped.</p>
        </div>
      </article>

      <article class="card" data-r style="--d:1">
        <div class="vg" aria-hidden="true">
          <div class="win">
            <div class="win-h"><b>Resources</b> <span class="wn">api</span></div>
            <div class="lim">
              {LIMITS.map(([k, v]) => <div class="lr"><span>{k}</span><b>[{v.padEnd(16)}]</b></div>)}
              <div class="lnote">Applied live with `docker update`.</div>
              <div class="cmdl">Updated resources of api</div>
            </div>
          </div>
        </div>
        <div>
          <h3>Change container limits</h3>
          <p><code>Alt+u</code> edits CPUs, memory, swap, PIDs and restart policy with <code>docker update</code>. The
            container keeps running.</p>
        </div>
      </article>

      <article class="card" data-r style="--d:2">
        <div class="vg" aria-hidden="true">
          <div class="win">
            <div class="win-h"><b>api</b> · environment</div>
            <div class="env">
              {ENV.map(([k, v, secret]) => (
                <div><span class="k">{k}</span>=<span class:list={["v", { mask: secret }]}>{secret ? "••••••" : v}</span></div>
              ))}
            </div>
            <div class="env-k"><kbd>Alt</kbd><kbd>s</kbd><span>show secrets</span></div>
          </div>
        </div>
        <div>
          <h3>Secrets hidden</h3>
          <p>Env values are hidden when the name contains <code>pass</code>, <code>secret</code>, <code>token</code>,
            <code>key</code>, <code>credential</code> or <code>auth</code>. <code>Alt+s</code> shows them.</p>
        </div>
      </article>

      <article class="card s3 plat" data-r>
        {PLATFORMS.map((p) => (
          <div>
            <div class="plat-os">{p.os}</div>
            <div class="plat-word">{p.w}{p.c && <span class="c">{p.c}</span>}</div>
            <ul class="plat-list">{p.l.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </article>
    </div>
  </div>

</section>
