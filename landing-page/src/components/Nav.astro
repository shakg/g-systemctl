---
import { SITE, url } from "../lib/site";
import { repoInfo } from "../lib/github";

const { stars } = await repoInfo();
const onBlog = Astro.url.pathname.startsWith(url("blog/"));
// The home page turns the bar solid on scroll; other pages start with content under it.
const home = Astro.url.pathname === url();
---

<nav class:list={["nav", { solid: !home }]} id="nav" aria-label="Primary">
  <a class="brand" href={url()}><span class="brand-mark" aria-hidden="true">g</span>g-systemctl</a>
  <div class="nav-links">
    <a class="opt" href={url("#features")}>Features</a>
    <a class="opt" href={url("#keys")}>Keys</a>
    <a href={url("blog/")} aria-current={onBlog ? "page" : undefined}>Blog</a>
    <a href={url("#install")}>Install</a>
    <a class="gh" href={SITE.repo} target="_blank" rel="noopener" data-umami-event="github_click" data-umami-event-place="nav" aria-label={stars !== null ? `GitHub, ${stars} stars` : "GitHub"}>
      <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.22-3.37-1.22-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.34 9.34 0 0 1 12 6.97c.85 0 1.7.12 2.5.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.71 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.14 10.14 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" /></svg>
      <span class="opt-t">GitHub</span>{stars !== null && <span class="stars" aria-hidden="true">★ {stars}</span>}
    </a>
  </div>
</nav>
